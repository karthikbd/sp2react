{
  "rules": [
    {"id": "R1", "kind": "derive", "field": "RiskRating", "modes": ["new", "edit"],
     "params": {"from_field": "Country", "column": "RiskLevel"},
     "covers": ["SiteAssets/js/vendor-request-form.js#L47:set_value", "SiteAssets/js/vendor-request-form.js#L56:set_value", "SiteAssets/js/vendor-request-form.js#L52:rest_call"],
     "src": ["SiteAssets/js/vendor-request-form.js:44", "SiteAssets/js/vendor-request-form.js:152"],
     "note": "VR.loadRisk: on Country change GET Countries(id)?$select=RiskLevel and copy it into Risk Rating; cleared when no country."},
    {"id": "R2", "kind": "readonly", "field": "RiskRating", "modes": ["new", "edit"],
     "covers": ["SiteAssets/js/vendor-request-form.js#L150:readonly"], "src": ["SiteAssets/js/vendor-request-form.js:150"]},
    {"id": "R3", "kind": "visible", "field": "HighRiskJustification", "modes": ["new", "edit"],
     "when": {"field": "RiskRating", "eq": "High"},
     "covers": ["SiteAssets/js/vendor-request-form.js#L63:visibility"], "src": ["SiteAssets/js/vendor-request-form.js:62"]},
    {"id": "R4", "kind": "visible", "field": "HighRiskJustification", "modes": ["display"],
     "when": {"field": "HighRiskJustification", "notEmpty": true},
     "covers": ["Lists/VendorRequests/DispForm.aspx#inline1#L14:visibility"], "src": ["Lists/VendorRequests/DispForm.aspx#inline1:12"]},
    {"id": "R5", "kind": "required", "field": "HighRiskJustification", "modes": ["new", "edit"],
     "when": {"field": "RiskRating", "eq": "High"},
     "message": "High Risk Justification is required for vendors in high-risk countries.", "presentation": "alert",
     "covers": ["SiteAssets/js/vendor-request-form.js#L183:save_validation"], "src": ["SiteAssets/js/vendor-request-form.js:181"]},
    {"id": "R6", "kind": "visible", "field": "ScreeningResult",
     "when": {"any": [{"mode": "display"}, {"field": "SanctionsScreened", "eq": true}]},
     "params": {"clear": true},
     "covers": ["SiteAssets/js/vendor-request-form.js#L68:visibility", "SiteAssets/js/vendor-request-form.js#L70:set_value"],
     "src": ["SiteAssets/js/vendor-request-form.js:66"],
     "note": "VR.toggleScreening runs on New and Edit; unchecking also clears the result. DispForm shows the field as usual."},
    {"id": "R7", "kind": "required", "field": "ScreeningResult", "modes": ["new", "edit"],
     "when": {"field": "SanctionsScreened", "eq": true},
     "message": "Select a Screening Result when Sanctions Screened is checked.", "presentation": "alert",
     "covers": ["SiteAssets/js/vendor-request-form.js#L192:save_validation"], "src": ["SiteAssets/js/vendor-request-form.js:191"]},
    {"id": "R8", "kind": "required", "field": "SecondApprover", "modes": ["new", "edit"],
     "when": {"field": "ContractValue", "gt": 100000},
     "message": "A Second Approver is required for contracts over $100,000.", "presentation": "alert",
     "covers": ["SiteAssets/js/vendor-request-form.js#L188:save_validation"], "src": ["SiteAssets/js/vendor-request-form.js:186"]},
    {"id": "R9", "kind": "compare", "field": "StartDate", "modes": ["new", "edit"],
     "params": {"op": "gte", "other": "RequestDate"},
     "message": "Expected Start Date cannot be before the Request Date.", "presentation": "alert",
     "covers": ["SiteAssets/js/vendor-request-form.js#L198:save_validation"], "src": ["SiteAssets/js/vendor-request-form.js:195"]},
    {"id": "R10", "kind": "unique", "field": "TaxID", "modes": ["new", "edit"],
     "message": "A vendor request with this Tax ID already exists (ID {duplicate_id}).", "presentation": "alert",
     "covers": ["SiteAssets/js/vendor-request-form.js#L82:rest_call", "SiteAssets/js/vendor-request-form.js#L88:message", "SiteAssets/js/vendor-request-form.js#L178:save_validation"],
     "src": ["SiteAssets/js/vendor-request-form.js:75", "SiteAssets/js/vendor-request-form.js:177"],
     "note": "Checked on blur (inline message under Tax ID) and again on save (alert), excluding the current item in edit mode."},
    {"id": "R11", "kind": "cascade", "field": "CostCenter", "modes": ["new", "edit"],
     "params": {"parent": "Department", "via": "Department"},
     "covers": ["SiteAssets/js/vendor-request-form.js#L128:cascade"], "src": ["SiteAssets/js/vendor-request-form.js:128"]},
    {"id": "R12", "kind": "default", "field": "Requester", "modes": ["new"], "params": {"value": "@me"},
     "covers": ["SiteAssets/js/vendor-request-form.js#L139:default_value"], "src": ["SiteAssets/js/vendor-request-form.js:139"]},
    {"id": "R13", "kind": "readonly", "field": "Requester", "modes": ["new", "edit"],
     "covers": ["SiteAssets/js/vendor-request-form.js#L149:readonly"], "src": ["SiteAssets/js/vendor-request-form.js:149"]},
    {"id": "R14", "kind": "visible", "field": "Status", "modes": ["edit", "display"],
     "covers": ["SiteAssets/js/vendor-request-form.js#L145:visibility"], "src": ["SiteAssets/js/vendor-request-form.js:145"],
     "note": "Hidden on NewForm only."},
    {"id": "R15", "kind": "set_on_save", "field": "Status", "modes": ["new"], "params": {"value": "Submitted"},
     "covers": ["SiteAssets/js/vendor-request-form.js#L207:set_value"], "src": ["SiteAssets/js/vendor-request-form.js:206"]},
    {"id": "R16", "kind": "readonly", "field": "Status", "modes": ["edit"],
     "when": {"not": {"role": "Compliance Reviewers"}},
     "covers": ["SiteAssets/js/vendor-request-form.js#L169:readonly", "SiteAssets/js/vendor-request-form.js#L123:role_check", "SiteAssets/js/vendor-request-form.js#L118:spservices_call"],
     "src": ["SiteAssets/js/vendor-request-form.js:118", "SiteAssets/js/vendor-request-form.js:168"]},
    {"id": "R17", "kind": "visible", "field": "ReviewerComments",
     "when": {"any": [{"mode": "display"}, {"all": [{"mode": "edit"}, {"role": "Compliance Reviewers"}]}]},
     "covers": ["SiteAssets/js/vendor-request-form.js#L146:visibility", "SiteAssets/js/vendor-request-form.js#L170:visibility"],
     "src": ["SiteAssets/js/vendor-request-form.js:146", "SiteAssets/js/vendor-request-form.js:170"],
     "note": "Hidden on NewForm; on EditForm only reviewers see it; DispForm shows it to everyone."},
    {"id": "R18", "kind": "required", "field": "ReviewerComments", "modes": ["edit"],
     "when": {"field": "Status", "eq": "Rejected"},
     "message": "Please enter reviewer comments when rejecting a request.", "presentation": "alert",
     "covers": ["SiteAssets/js/vendor-request-form.js#L203:save_validation"], "src": ["SiteAssets/js/vendor-request-form.js:202"]},
    {"id": "R19", "kind": "lock_item", "modes": ["edit"],
     "when": {"all": [{"field": "Status", "in": ["Approved", "Rejected"]}, {"not": {"role": "Compliance Reviewers"}}]},
     "message": "This request has been {Status|lower} and can no longer be edited.", "presentation": "alert",
     "params": {"redirect": "display"},
     "covers": ["SiteAssets/js/vendor-request-form.js#L164:message", "SiteAssets/js/vendor-request-form.js#L165:navigate"],
     "src": ["SiteAssets/js/vendor-request-form.js:163"]},
    {"id": "R20", "kind": "on_save", "modes": ["edit"],
     "when": {"field": "ScreeningResult", "eq": "Confirmed Match", "changed": true},
     "params": {"action": {"type": "create_item", "list": "ComplianceAlerts",
                "values": {"Title": "Confirmed sanctions match: {Title}", "VendorRequest": "{ID}", "Country": "{Country.title}"}}},
     "covers": ["SiteAssets/js/vendor-request-form.js#L99:rest_call"], "src": ["SiteAssets/js/vendor-request-form.js:95", "SiteAssets/js/vendor-request-form.js:208"]},
    {"id": "R21", "kind": "banner", "modes": ["display"],
     "when": {"field": "ScreeningResult", "eq": "Confirmed Match"},
     "message": "This vendor has a confirmed sanctions match. Do not issue a purchase order.", "presentation": "banner",
     "covers": ["Lists/VendorRequests/DispForm.aspx#inline1#L10:message"], "src": ["Lists/VendorRequests/DispForm.aspx#inline1:9"]}
  ],
  "components": [
    {"id": "reviewer-instructions", "kind": "html", "title": "Reviewer Instructions", "region": "before", "order": 1,
     "props": {"modes": ["edit"], "legacy_html": "<div class=\"vr-instructions\">\n  <strong>Compliance reviewers:</strong> confirm the sanctions screening result and the risk rating before changing the status to Approved.\n  Rejections must include reviewer comments.\n</div>"},
     "src": ["Lists/VendorRequests/EditForm.aspx"]},
    {"id": "help", "kind": "html", "title": "Script Editor", "region": "after", "order": 4,
     "props": {"modes": ["new", "edit"], "legacy_html": "<div class=\"vr-help\">Complete all required fields. Requests over $100,000 need a second approver.</div>"},
     "src": ["Lists/VendorRequests/NewForm.aspx", "Lists/VendorRequests/EditForm.aspx"]}
  ],
  "endpoints": [],
  "not_carried": [],
  "open_questions": [
    "The legacy Tax ID duplicate check ran only on blur, so a request saved without leaving the field skipped it; the new app also checks on save and on the server. Confirm this stricter behaviour is acceptable, or the check can be limited to the blur event."
  ]
}
